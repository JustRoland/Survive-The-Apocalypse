.inv-icon {
    padding-right: 12px;
    margin-right: 12px;
    margin-top: 12px;
    margin-bottom: 12px;
    margin-left: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    background-color: rgb(120, 120, 120);
    width: 12%;
    height: 8%;
    aspect-ratio: 1;
    flex-direction: row-reverse;
    align-items: flex-end;
}

.header-1 {
    font-size: 256%;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-top: 1%;
    margin-right: 1%;
    margin-bottom: 1%;
    margin-left: 1%;
    padding-top: 1%;
    padding-bottom: 1%;
    padding-left: 1%;
    padding-right: 1%;
    width: 100%;
    height: 8%;
}

.inv-button {
    width: 30%;
    height: 80%;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-right-width: 6px;
    border-bottom-width: 6px;
    border-top-width: 2px;
    border-left-width: 2px;
    border-top-color: rgb(209, 209, 209);
    border-left-color: rgb(213, 213, 213);
    border-bottom-color: rgb(105, 105, 105);
    -unity-font-style: bold;
    text-shadow: 1px 1px 0 rgb(138, 138, 138);
    font-size: 22px;
}

.num-text {
    -unity-text-align: upper-right;
    -unity-font-style: bold;
    font-size: 24px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.base-container {
    align-content: center;
    align-items: center;
    justify-content: space-around;
    height: 100%;
    width: 100%;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.main-window {
    width: 80%;
    height: 80%;
    background-color: rgb(45, 26, 27);
}
